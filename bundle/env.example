# OpenFn Lightning air-gapped deployment example environment file
# Copy this file to .env before installation:
# cp env.example .env

# PostgreSQL
POSTGRES_USER=lightning
POSTGRES_PASSWORD=change-this-postgres-password
POSTGRES_DB=lightning

# Lightning network
LIGHTNING_HOST=localhost
LIGHTNING_PORT=4000
LISTEN_ADDRESS=0.0.0.0

# Lightning secrets
SECRET_KEY_BASE=change-this-secret-key-base
PRIMARY_ENCRYPTION_KEY=change-this-primary-encryption-key

# Database URL used by Lightning.
# ssl=false is used because Postgres runs locally inside Docker Compose without SSL.
DATABASE_URL=postgresql://lightning:change-this-postgres-password@postgres:5432/lightning?ssl=false

# Disable outbound telemetry/tracking for air-gapped deployment
USAGE_TRACKING_ENABLED=false

# Worker security
# WORKER_RUNS_PRIVATE_KEY and WORKER_LIGHTNING_PUBLIC_KEY must be base64-encoded PEM keys.
WORKER_RUNS_PRIVATE_KEY=change-this-worker-runs-private-key
WORKER_LIGHTNING_PUBLIC_KEY=change-this-worker-lightning-public-key
WORKER_SECRET=change-this-worker-secret

# Node.js DNS behavior for workers
NODE_OPTIONS=--dns-result-order=ipv4first

# Optional SMTP/OIDC settings are intentionally not enabled in this basic package.
